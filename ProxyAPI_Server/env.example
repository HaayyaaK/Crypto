# ==============================================================
# Crypto Data Proxy — Environment Configuration
# Copy this file to .env and fill in your actual keys.
#   cp .env.example .env
# ==============================================================

# --------------- SERVER ---------------
PORT=3210
NODE_ENV=production
LOG_LEVEL=info                        # debug | info | warn | error
CORS_ORIGIN=*                         # Set to your frontend URL in production

# --------------- CACHE ---------------
CACHE_TTL_TICKER_MS=5000              # Ticker cache: 5 s (real-time feel)
CACHE_TTL_OHLCV_MS=15000             # OHLCV cache: 15 s
CACHE_TTL_REFERENCE_MS=60000          # Reference/validation cache: 60 s
CACHE_MAX_ENTRIES=2000                # Max cached responses (LRU eviction)

# --------------- CIRCUIT BREAKER ---------------
CB_FAILURE_THRESHOLD=5               # Failures before circuit opens
CB_RESET_TIMEOUT_MS=30000            # Cooldown before half-open retry
CB_HALF_OPEN_MAX=2                   # Probes allowed in half-open state

# --------------- GLOBAL RATE LIMIT (proxy side) ---------------
GLOBAL_RATE_LIMIT_RPM=600            # Requests per minute the proxy itself accepts
GLOBAL_RATE_LIMIT_BURST=50           # Burst capacity (token bucket)

# ==============================================================
# PROVIDER: Kraken  (https://docs.kraken.com/rest/)
# Public REST — NO API KEY required for market data.
# Tier: Public | Rate: ~1 req/s unauth'd | No key rotation needed.
# ==============================================================
KRAKEN_ENABLED=true
KRAKEN_BASE_URL=https://api.kraken.com/0/public
KRAKEN_WS_URL=wss://ws.kraken.com/
KRAKEN_TIMEOUT_MS=8000
KRAKEN_PAIR_BTC_USD=XBTUSD
KRAKEN_PAIR_ETH_USD=ETHUSD

# ==============================================================
# PROVIDER: Coinbase Exchange  (https://docs.cloud.coinbase.com/exchange/reference/)
# Public REST — NO API KEY required for market data.
# Tier: Public | Rate: ~10 req/s | No key rotation needed.
# ==============================================================
COINBASE_ENABLED=true
COINBASE_BASE_URL=https://api.exchange.coinbase.com
COINBASE_TIMEOUT_MS=8000

# ==============================================================
# PROVIDER: Binance  (https://binance-docs.github.io/apidocs/spot/en/)
# Public REST — NO API KEY for market data.  May be geo-restricted (US).
# Tier: Public | Rate: 1200 req/min (weight-based) | No key rotation for public.
# NOTE: For Binance.US use https://api.binance.us/api/v3
# ==============================================================
BINANCE_ENABLED=true
BINANCE_BASE_URL=https://api.binance.com/api/v3
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
BINANCE_TIMEOUT_MS=8000
BINANCE_PAIR_BTC_USD=BTCUSDT
BINANCE_PAIR_ETH_USD=ETHUSDT
# Set to true if Binance.com is geo-restricted in your region:
BINANCE_USE_US=false
BINANCE_US_BASE_URL=https://api.binance.us/api/v3

# ==============================================================
# PROVIDER: CoinGecko  (https://docs.coingecko.com/reference/introduction)
# Free tier: 10-30 calls/min (varies). Demo key raises to ~500/min.
# Optional API key via ?x_cg_demo_api_key= header or query param.
# ==============================================================
COINGECKO_ENABLED=true
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_TIMEOUT_MS=10000
# Comma-separated list of demo/pro API keys for rotation:
COINGECKO_API_KEYS=key1,key2,key3
# Rate limit (calls per minute) per key:
COINGECKO_RATE_LIMIT_PER_KEY=25

# ==============================================================
# PROVIDER: CoinPaprika  (https://api.coinpaprika.com/docs/)
# Free, NO API KEY.  Rate: 25,000 req/month (free) — use sparingly.
# ==============================================================
COINPAPRIKA_ENABLED=true
COINPAPRIKA_BASE_URL=https://api.coinpaprika.com/v1
COINPAPRIKA_TIMEOUT_MS=10000

# ==============================================================
# PROVIDER: DexScreener  (https://docs.dexscreener.com/api/)
# Free, NO API KEY.  Rate: ~300 req/min.  DEX on-chain data.
# ==============================================================
DEXSCREENER_ENABLED=true
DEXSCREENER_BASE_URL=https://api.dexscreener.com/latest
DEXSCREENER_TIMEOUT_MS=10000

# ==============================================================
# PROVIDER: CoinMarketCap  (https://coinmarketcap.com/api/documentation/)
# REQUIRES API KEY.  Basic: 10,000 calls/mo | Pro: 30,000+/mo
# Keys rotate round-robin; rate-limited keys auto-cool down.
# ==============================================================
COINMARKETCAP_ENABLED=true
COINMARKETCAP_BASE_URL=https://pro-api.coinmarketcap.com
COINMARKETCAP_TIMEOUT_MS=10000
# Comma-separated list of API keys (Basic + Pro keys can be mixed):
COINMARKETCAP_API_KEYS=cmc-key-1,cmc-key-2,cmc-key-3
# Per-key rate limit (calls per minute):
COINMARKETCAP_RATE_LIMIT_PER_KEY=30
# HTTP header name for key:
COINMARKETCAP_KEY_HEADER=X-CMC_PRO_API_KEY

# ==============================================================
# PROVIDER: CoinAPI  (https://docs.coinapi.io/)
# REQUIRES API KEY.  Free: 100 calls/day | Starter: $49/mo | ...
# Keys rotate round-robin; rate-limited keys auto-cool down.
# ==============================================================
COINAPI_ENABLED=true
COINAPI_BASE_URL=https://rest.coinapi.io/v1
COINAPI_WS_URL=wss://ws.coinapi.io/v1
COINAPI_TIMEOUT_MS=10000
# Comma-separated list of API keys:
COINAPI_API_KEYS=coinapi-key-1,coinapi-key-2
# Per-key rate limit (calls per day for free, per minute for paid):
COINAPI_RATE_LIMIT_PER_KEY=10
COINAPI_RATE_LIMIT_WINDOW_MS=60000      # Window for the rate limit counter
# HTTP header name for key:
COINAPI_KEY_HEADER=X-CoinAPI-Key

# ==============================================================
# OPTIONAL: Proxy Upstream (for providers behind corporate proxy)
# ==============================================================
# HTTPS_PROXY=http://proxy.example.com:8080
# HTTP_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1